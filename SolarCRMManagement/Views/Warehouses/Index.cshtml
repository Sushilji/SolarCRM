@model IEnumerable<SolarCRMManagement.Models.Master.Warehouse>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BranchId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseManager)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MobileNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmailId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Capacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ModifiedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Branch)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.BranchId)
            </td>
            <td>
                @Html.DisplayFor(model => item.WarehouseCode)
            </td>
            <td>
                @Html.DisplayFor(model => item.WarehouseName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.WarehouseManager)
            </td>
            <td>
                @Html.DisplayFor(model => item.MobileNo)
            </td>
            <td>
                @Html.DisplayFor(model => item.EmailId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Capacity)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.ModifiedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Branch)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.WarehouseId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.WarehouseId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.WarehouseId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
