@model IEnumerable<SolarCRMManagement.Models.Master.District>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New District</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StateId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DistrictCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DistrictName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.State)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.StateId)
            </td>
            <td>
                @Html.DisplayFor(model => item.DistrictCode)
            </td>
            <td>
                @Html.DisplayFor(model => item.DistrictName)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.State)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DistrictId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.DistrictId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.DistrictId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
